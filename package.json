{
  "name": "itd",
  "productName": "ИТД",
  "version": "0.0.7",
  "description": "ИТД App",
  "author": "YaOblako",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.itd.app",
    "productName": "ИТД",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "ИТД"
    },
    "publish": {
      "provider": "github",
      "owner": "YaOblako",
      "repo": "ITD"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}