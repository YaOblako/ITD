{
  "name": "itd",
  "productName": "ИТД",
  "version": "0.0.5",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.itd.app",
    "productName": "ИТД",
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.png",
      "target": {
        "target": "nsis",
        "arch": ["x64"]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  }
}